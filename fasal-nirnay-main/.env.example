# ============================================================
# FasalNirnay — Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit your actual .env file to Git.
#
#   cp .env.example .env
# ============================================================


# ------------------------------------------------------------
# WEATHER API
# Sign up at https://www.weatherapi.com/ (free tier available)
# ------------------------------------------------------------
WEATHER_API_KEY=3efdc3808d044cff991115137260804


# ------------------------------------------------------------
# NEWS API
# Sign up at https://gnews.io/ (free tier: 100 req/day)
# Alternative: https://newsapi.org/
# ------------------------------------------------------------
NEWS_API_KEY=20c3aa6af11c5b9ef647828e22b08112


# ------------------------------------------------------------
# LLM / AI CHATBOT (Gemini Primary + Ollama Fallback)
# ------------------------------------------------------------
# Google Gemini API — Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Ollama Local LLM Fallback (Active when GEMINI_API_KEY is not set or unreachable)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3



# ------------------------------------------------------------
# SPEECH — STT / TTS
# Options: sarvam | google | mock
# ------------------------------------------------------------
SPEECH_PROVIDER=sarvam

# Sarvam AI — Best choice for Indic language STT/TTS
# Sign up at: https://dashboard.sarvam.ai/
# Docs:       https://docs.sarvam.ai/
# Supports:   Hindi, Marathi, Bengali, Tamil, Telugu, Kannada, Gujarati, Punjabi, English
SARVAM_API_KEY=sk_8od31rpk_A6CI51eyExNdlzCNseKYoN1e

# (Optional) Google Cloud Speech — alternative provider
# Download service account JSON from: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account.json


# ------------------------------------------------------------
# APP SETTINGS
# ------------------------------------------------------------
APP_ENV=development
APP_PORT=8000
