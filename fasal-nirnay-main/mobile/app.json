{
    "expo": {
        "name": "FasalNirnay",
        "slug": "fasalnirnay",
        "version": "1.0.0",
        "scheme": "fasalnirnay",
        "orientation": "portrait",
        "icon": "./assets/icon.png",
        "splash": {
            "image": "./assets/splash-icon.png",
            "resizeMode": "contain",
            "backgroundColor": "#2E7D32"
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/adaptive-icon.png",
                "backgroundColor": "#2E7D32"
            },
            "package": "com.fasalnirnay.app"
        },
        "plugins": [
            "expo-router",
            "expo-location",
            [
                "expo-av",
                {
                    "microphonePermission": "FasalNirnay needs microphone for voice questions."
                }
            ]
        ],
        "experiments": {
            "typedRoutes": true
        }
    }
}